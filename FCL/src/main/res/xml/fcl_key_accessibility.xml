<?xml version="1.0" encoding="utf-8"?>
<!--
  实体键盘接管服务配置。

  canRequestFilterKeyEvents / flagRequestFilterKeyEvents：核心开关，没有它就拿不到按键。
  accessibilityEventTypes / accessibilityFeedbackType：仅为满足系统对无障碍服务的必填要求，
  服务本身不处理任何无障碍事件，也不读取窗口内容（canRetrieveWindowContent=false）。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_key_service_description"
    android:notificationTimeout="0"
    android:summary="@string/accessibility_key_service_description" />
